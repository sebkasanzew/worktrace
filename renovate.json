{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "schedule:automergeEarlyMondays"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)biome\\.json$/"
      ],
      "matchStrings": [
        "\\\"\\$schema\\\"\\s*:\\s*\\\"https://biomejs.dev/schemas/(?<currentValue>\\d+\\.\\d+\\.\\d+)/schema\\.json\\\""
      ],
      "depNameTemplate": "@biomejs/biome",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "rangeStrategy": "pin"
    },
    {
      "matchPackageNames": [
        "@tauri-apps/**",
        "tauri",
        "tauri-build",
        "tauri-plugin-*"
      ],
      "matchManagers": [
        "cargo",
        "npm"
      ],
      "groupName": "tauri dependencies",
      "rangeStrategy": "pin",
      "separateMajorMinor": false,
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "!@tauri-apps/**",
        "!tauri",
        "!tauri-build",
        "!tauri-plugin-*"
      ],
      "groupName": "rust dependencies",
      "rangeStrategy": "pin",
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "!@tauri-apps/**",
        "!tauri",
        "!tauri-build",
        "!tauri-plugin-*"
      ],
      "groupName": "pnpm dependencies",
      "automerge": true,
      "minimumReleaseAge": "3 days"
    }
  ]
}
