{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "schedule:automergeEarlyMondays"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)rust-toolchain\\.toml$/"
      ],
      "matchStrings": [
        "channel\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "rust",
      "datasourceTemplate": "rust",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "tauri"
      ],
      "matchPackagePatterns": [
        "^@tauri-apps/",
        "^tauri-plugin-",
        "^tauri-specta",
        "^tauri-build"
      ],
      "matchManagers": [
        "cargo",
        "npm"
      ],
      "groupName": "tauri dependencies"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "groupName": "rust dependencies",
      "minimumReleaseAge": "3 days"
    },
    {
      "matchDatasources": [
        "npm"
      ],
      "groupName": "pnpm dependencies",
      "minimumReleaseAge": "3 days"
    }
  ]
}
