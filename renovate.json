{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "schedule:automergeEarlyMondays"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)rust-toolchain\\.toml$/"
      ],
      "matchStrings": [
        "channel\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "rust",
      "datasourceTemplate": "rust",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "@tauri-apps/**",
        "tauri",
        "tauri-build",
        "tauri-plugin-*",
        "tauri-specta"
      ],
      "matchManagers": [
        "cargo",
        "npm"
      ],
      "groupName": "tauri dependencies",
      "separateMajorMinor": false,
      "minimumReleaseAge": "3 days"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "excludePackageNames": [
        "@tauri-apps/**",
        "tauri",
        "tauri-build",
        "tauri-plugin-*",
        "tauri-specta"
      ],
      "groupName": "rust dependencies",
      "minimumReleaseAge": "3 days"
    },
    {
      "matchDatasources": [
        "npm"
      ],
      "excludePackageNames": [
        "@tauri-apps/**",
        "tauri",
        "tauri-build",
        "tauri-plugin-*",
        "tauri-specta"
      ],
      "groupName": "pnpm dependencies",
      "minimumReleaseAge": "3 days"
    }
  ]
}
