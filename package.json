{
  "name": "worktrace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "preview": "vite preview",
    "build:all": "tauri build",
    "build:macos": "tauri build --bundles app",
    "build:windows": "tauri build --bundles msi",
    "build:linux": "tauri build --bundles deb,appimage",
    "tauri": "tauri",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "gen:zod:bindings": "ts-to-zod --config bindings && biome check --write src/types/bindings.zod.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "5.90.10",
    "@tauri-apps/plugin-dialog": "2.4.2",
    "@tauri-apps/plugin-log": "2.7.1",
    "@tauri-apps/plugin-opener": "2.5.2",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-store": "2.4.1",
    "@tauri-apps/plugin-updater": "2.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.554.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.66.1",
    "tailwind-merge": "3.4.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.7",
    "@faker-js/faker": "10.1.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.17",
    "@tauri-apps/api": "2.9.0",
    "@tauri-apps/cli": "2.9.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "merge-partially": "2.0.2",
    "tailwindcss": "4.1.17",
    "ts-to-zod": "5.0.1",
    "typescript": "5.9.3",
    "vite": "7.2.4"
  }
}
