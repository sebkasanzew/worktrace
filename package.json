{
  "name": "worktrace",
  "private": true,
  "version": "0.4.5",
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite --host",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "preview": "vite preview",
    "build:all": "node scripts/build-with-key.mts tauri build",
    "build:macos": "node scripts/build-with-key.mts tauri build --bundles app",
    "build:windows": "node scripts/build-with-key.mts tauri build --bundles nsis,msi",
    "build:linux": "node scripts/build-with-key.mts tauri build --bundles deb,appimage",
    "tauri": "tauri",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:demo": "playwright test --config playwright.demo.config.ts",
    "test:build-scripts": "node scripts/test-build-scripts.mts",
    "test:release": "node scripts/test-release.mts",
    "version:bump": "node scripts/bump-version.mts",
    "updater:generate-json": "node scripts/generate-latest-json.mts",
    "updater:merge-json": "node scripts/merge-latest-json.mts",
    "release:hash": "node scripts/hash-artifacts.mts",
    "release:manifests": "node scripts/generate-package-manifests.mts",
    "gen:zod:bindings": "ts-to-zod --config bindings && biome check --write src/types/bindings.zod.ts",
    "i18n:extract": "i18next",
    "ui:add": "pnpm dlx shadcn@latest add"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@radix-ui/react-checkbox": "1.3.4",
    "@radix-ui/react-dialog": "1.1.16",
    "@radix-ui/react-popover": "1.1.16",
    "@radix-ui/react-scroll-area": "1.2.11",
    "@radix-ui/react-select": "2.3.0",
    "@tanstack/react-query": "5.101.0",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "@tauri-apps/plugin-fs": "2.4.5",
    "@tauri-apps/plugin-log": "2.8.0",
    "@tauri-apps/plugin-opener": "2.5.3",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-store": "2.4.2",
    "@tauri-apps/plugin-updater": "2.10.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "i18next": "26.3.1",
    "i18next-browser-languagedetector": "8.2.1",
    "lucide-react": "1.17.0",
    "react": "19.2.7",
    "react-big-calendar": "1.20.0",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.7",
    "react-error-boundary": "6.1.2",
    "react-hook-form": "7.78.0",
    "react-i18next": "17.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@faker-js/faker": "10.4.0",
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "4.3.0",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/cli": "2.10.1",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-big-calendar": "1.16.3",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "i18next-parser": "9.4.0",
    "merge-partially": "2.0.2",
    "tailwindcss": "4.3.0",
    "ts-to-zod": "5.1.0",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  }
}
