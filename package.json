{
  "name": "worktrace",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite --host",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "preview": "vite preview",
    "build:all": "node scripts/build-with-key.mts tauri build",
    "build:macos": "node scripts/build-with-key.mts tauri build --bundles app",
    "build:windows": "node scripts/build-with-key.mts tauri build --bundles nsis,msi",
    "build:linux": "node scripts/build-with-key.mts tauri build --bundles deb,appimage",
    "tauri": "tauri",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:build-scripts": "node scripts/test-build-scripts.mts",
    "test:release": "node scripts/test-release.mts",
    "version:bump": "node scripts/bump-version.mts",
    "updater:generate-json": "node scripts/generate-latest-json.mts",
    "updater:merge-json": "node scripts/merge-latest-json.mts",
    "release:hash": "node scripts/hash-artifacts.mts",
    "release:manifests": "node scripts/generate-package-manifests.mts",
    "gen:zod:bindings": "ts-to-zod --config bindings && biome check --write src/types/bindings.zod.ts",
    "i18n:extract": "i18next"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@tanstack/react-query": "5.90.10",
    "@tauri-apps/plugin-dialog": "2.4.2",
    "@tauri-apps/plugin-log": "2.7.1",
    "@tauri-apps/plugin-opener": "2.5.2",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-store": "2.4.1",
    "@tauri-apps/plugin-updater": "2.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "i18next": "25.6.3",
    "i18next-browser-languagedetector": "8.2.0",
    "lucide-react": "0.554.0",
    "react": "19.2.0",
    "react-day-picker": "9.11.1",
    "react-dom": "19.2.0",
    "react-hook-form": "7.66.1",
    "react-i18next": "16.3.5",
    "tailwind-merge": "3.4.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.7",
    "@faker-js/faker": "10.1.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.17",
    "@tauri-apps/api": "2.9.0",
    "@tauri-apps/cli": "2.9.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "i18next-parser": "9.3.0",
    "merge-partially": "2.0.2",
    "tailwindcss": "4.1.17",
    "tailwindcss-animate": "1.0.7",
    "ts-to-zod": "5.0.1",
    "typescript": "5.9.3",
    "vite": "7.2.4"
  }
}
