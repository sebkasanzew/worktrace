# Handle line endings automatically for files detected as text
* text=auto

# Binary files - treat as binary, use Git LFS for large files
*.webm binary
*.mp4 binary
*.mov binary
*.avi binary
*.gif binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.dmg binary
*.exe binary
*.msi binary

# Lock files - don't diff
pnpm-lock.yaml -diff
Cargo.lock -diff
